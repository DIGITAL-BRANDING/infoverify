Subject: [PATCH] Clean up index.css royal-blue overrides: fix white
 forms/inputs being force-recolored, remove dead main#home rules and duplicate
 blocks

---
 web/src/index.css                             | 163 +++++++-----------
 .../pages/verification/IpeClearancePage.tsx   |   2 +-
 web/src/pages/verification/ValidationPage.tsx |   2 +-
 3 files changed, 64 insertions(+), 103 deletions(-)

diff --git a/web/src/index.css b/web/src/index.css
index 154dff0..2f22ef1 100644
--- a/web/src/index.css
+++ b/web/src/index.css
@@ -86,30 +86,61 @@ select:focus-visible, textarea:focus-visible {
   box-shadow: inset 0 1px 0 rgba(255, 237, 169, .18), 0 8px 20px rgba(54, 31, 0, .22);
 }
 
-/* Final service-page theme override: keep every service surface royal blue. */
-main .bg-parchment,
+/* ── Royal-blue premium recolor for legacy pages ─────────────────────
+   Several older pages (Dashboard, Buy Airtime/Data, Fund Wallet, Receipts,
+   Referral, Result Checkers, the original all-in-one VerificationPage,
+   NinModificationPage, etc.) still use the original cream/parchment/gold
+   utility classes from before the "royal blue premium" redesign. Rather
+   than rewriting every one of those pages, their cream/parchment surfaces
+   are recolored here to match the rest of the app.
+
+   SCOPING IS DELIBERATE: every selector below requires the legacy
+   `bg-cream` / `bg-parchment` / `border-parchment-line` classes - never
+   plain `bg-white`. Pages built with the newer, explicit component system
+   (web/src/pages/verification/*, via components/verification/shared.tsx)
+   intentionally use `bg-white` for their form sections with royal-blue
+   TEXT - the opposite treatment from a legacy cream card. If a `bg-white`
+   selector is ever added back here, every new-system page's forms and
+   buttons silently invert to unreadable dark-on-dark (this happened once
+   already - see git history "Fix color contrast" era). New legacy-style
+   pages should opt in with `bg-cream`/`bg-parchment`, never `bg-white`. */
 main .bg-cream,
-main .bg-white.rounded-xl,
-main .bg-white.rounded-2xl,
-main .border-parchment-line {
+main .bg-parchment,
+main .border-parchment-line,
+main [class~="bg-cream"],
+main [class~="bg-parchment"] {
   background-color: #0b2f73 !important;
   background-image: linear-gradient(145deg, #0b2f73 0%, #0d438d 58%, #071d4d 100%) !important;
-  border-color: rgba(96,165,250,.5) !important;
+  border-color: rgba(96, 165, 250, .5) !important;
   color: #f8fbff !important;
 }
-main .bg-parchment *, main .bg-cream *, main .bg-white.rounded-xl *, main .bg-white.rounded-2xl * { color: #f8fbff; }
-main input, main select, main textarea { background-color: #071d4d !important; color: #fff !important; border-color: #3b73c5 !important; }
-main .bg-gold-500 { background-color: #2563eb !important; color: #fff !important; }
+main .bg-cream *, main .bg-parchment * { color: #f8fbff; }
+main .bg-cream h1, main .bg-cream h2, main .bg-cream h3,
+main .bg-parchment h1, main .bg-parchment h2, main .bg-parchment h3 { color: #ffffff !important; }
+main .bg-cream .text-ink, main .bg-cream .text-ink-600, main .bg-cream .text-ink-400,
+main .bg-parchment .text-ink, main .bg-parchment .text-ink-600, main .bg-parchment .text-ink-400,
+main [class*="bg-parchment"] .text-ink, main [class*="bg-parchment"] .text-ink-600,
+main [class*="bg-cream"] .text-ink, main [class*="bg-cream"] .text-ink-600 { color: #ffffff !important; }
 
-/* Service pages use the same royal-blue premium surface as the dashboard. */
-main .bg-white.rounded-xl, main .bg-white.rounded-2xl,
-main .bg-cream.rounded-xl.border, main .bg-cream.rounded-2xl.border {
-  background: linear-gradient(145deg, #0b2f73, #0d438d 60%, #071d4d) !important;
-  border-color: rgba(96,165,250,.45) !important;
-  color: #f8fbff !important;
+/* Form fields inside a legacy cream/parchment card - same scoping as
+   above. A new-system page's inputs (inside a `bg-white` card) are
+   deliberately untouched and keep their white/royal-blue styling from
+   components/verification/shared.tsx (FORM_INPUT_CLASSES). */
+main .bg-cream input, main .bg-cream select, main .bg-cream textarea,
+main .bg-parchment input, main .bg-parchment select, main .bg-parchment textarea,
+main [class*="bg-cream"] input, main [class*="bg-cream"] select, main [class*="bg-cream"] textarea,
+main [class*="bg-parchment"] input, main [class*="bg-parchment"] select, main [class*="bg-parchment"] textarea {
+  background: #071d4d !important;
+  color: #ffffff !important;
+  border-color: #5b8ed8 !important;
 }
-main .bg-white.rounded-xl h1, main .bg-white.rounded-xl h2, main .bg-white.rounded-xl h3,
-main .bg-white.rounded-2xl h1, main .bg-white.rounded-2xl h2, main .bg-white.rounded-2xl h3 { color: #fff !important; }
+
+main .bg-gold-500 { background-color: #2563eb !important; color: #fff !important; }
+main button[class*="bg-cream"], main button[class*="bg-parchment"] { background: #1452a0 !important; color: #ffffff !important; border-color: #5b8ed8 !important; }
+main [class*="bg-\\[\\#6b4f0b\\]"] { background: #1452a0 !important; }
+main [class*="bg-\\#0A192F"] h1, main [class*="bg-\\#0A192F"] h2, main [class*="bg-\\#0A192F"] h3,
+main [class*="bg-\\#0b2f73"] h1, main [class*="bg-\\#0b2f73"] h2, main [class*="bg-\\#0b2f73"] h3 { color: #ffffff !important; }
+
 .service-tile::before {
   content: "";
   position: absolute;
@@ -172,95 +203,25 @@ main .bg-white.rounded-2xl h1, main .bg-white.rounded-2xl h2, main .bg-white.rou
 .premium-activity-date { color: #ffd86a; }
 .premium-activity-amount { color: #ffe69a; }
 
-/* Legacy page cards which still use the original light utility classes. */
-main .bg-white.rounded-xl,
-main .bg-white.rounded-2xl,
-main .bg-cream.rounded-xl.border,
-main .bg-cream.rounded-2xl.border {
-  border-color: rgba(212, 175, 55, .42) !important;
-  background: linear-gradient(145deg, #171106, #302004 62%, #4b3309) !important;
-  color: #fff4c9;
-  box-shadow: 0 12px 28px rgba(26, 15, 1, .17), inset 0 1px rgba(255, 221, 117, .12);
-}
-main .bg-white.rounded-xl .text-ink,
-main .bg-white.rounded-2xl .text-ink,
-main .bg-cream.rounded-xl.border .text-ink,
-main .bg-cream.rounded-2xl.border .text-ink { color: #fff4c9; }
-
-/* Premium surfaces used by service pages and shared containers.  The
-   selectors intentionally require a rounded card + border so form inputs
-   and status messages retain their semantic light/error colours. */
-main .rounded-2xl.border-parchment-line.bg-parchment,
-main .rounded-xl.border-parchment-line.bg-parchment,
-main .rounded-2xl.border.border-parchment-line.bg-parchment,
-main .rounded-xl.border.border-parchment-line.bg-parchment {
-  border-color: rgba(212, 175, 55, .42) !important;
-  background: linear-gradient(145deg, #171106 0%, #2b1c05 55%, #4a3208 100%) !important;
-  color: #fff4c9;
-  box-shadow: 0 12px 30px rgba(28, 17, 2, .16), inset 0 1px 0 rgba(255, 220, 112, .12);
-}
+/* Legacy page cards which still use the original light utility classes are
+   already covered by the consolidated ".bg-cream / .bg-parchment" rules
+   above - nothing further needed here. */
 
-main .rounded-2xl.border-parchment-line.bg-parchment h1,
-main .rounded-2xl.border-parchment-line.bg-parchment h2,
-main .rounded-2xl.border-parchment-line.bg-parchment h3,
-main .rounded-xl.border-parchment-line.bg-parchment h1,
-main .rounded-xl.border-parchment-line.bg-parchment h2,
-main .rounded-xl.border-parchment-line.bg-parchment h3 {
-  color: #fff4c9;
-}
-
-main .rounded-2xl.border-parchment-line.bg-parchment .text-ink-600,
-main .rounded-xl.border-parchment-line.bg-parchment .text-ink-600 {
-  color: #ead9a1;
-}
-
-main .rounded-2xl.border-parchment-line.bg-parchment:hover,
-main .rounded-xl.border-parchment-line.bg-parchment:hover {
-  border-color: rgba(255, 211, 78, .78) !important;
-  box-shadow: 0 16px 34px rgba(28, 17, 2, .24), 0 0 0 1px rgba(255, 211, 78, .18);
-}
 @media (prefers-reduced-motion: reduce) {
   .ticker-track { animation: none; }
 }
 
-/* Final royal-blue override for every authenticated service surface. */
-main .bg-white.rounded-xl, main .bg-white.rounded-2xl,
-main .bg-cream.rounded-xl.border, main .bg-cream.rounded-2xl.border,
-main .rounded-xl.border-parchment-line.bg-parchment,
-main .rounded-2xl.border-parchment-line.bg-parchment {
-  background: linear-gradient(145deg, #0b2f73, #0d438d 60%, #071d4d) !important;
-  border-color: #3b73c5 !important;
-  color: #ffffff !important;
-}
-main .bg-white.rounded-xl h1, main .bg-white.rounded-xl h2, main .bg-white.rounded-xl h3,
-main .bg-white.rounded-2xl h1, main .bg-white.rounded-2xl h2, main .bg-white.rounded-2xl h3,
-main .rounded-xl.border-parchment-line.bg-parchment h1, main .rounded-xl.border-parchment-line.bg-parchment h2,
-main .rounded-2xl.border-parchment-line.bg-parchment h1, main .rounded-2xl.border-parchment-line.bg-parchment h2 { color: #ffffff !important; }
-main input, main select, main textarea { background: #071d4d !important; color: #ffffff !important; border-color: #5b8ed8 !important; }
-main [class~="bg-cream"], main [class~="bg-parchment"] { background: #0b2f73 !important; color: #ffffff !important; border-color: #3b73c5 !important; }
-main [class*="bg-\\[\\#6b4f0b\\]"] { background: #1452a0 !important; }
-main button[class*="bg-cream"], main button[class*="bg-parchment"], main button[class*="bg-\\#6b4f0b"] { background: #1452a0 !important; color: #ffffff !important; border-color: #5b8ed8 !important; }
-main [class*="bg-parchment"] .text-ink, main [class*="bg-parchment"] .text-ink-600,
-main [class*="bg-cream"] .text-ink, main [class*="bg-cream"] .text-ink-600 { color: #ffffff !important; }
-main [class*="bg-\\#0A192F"] h1, main [class*="bg-\\#0A192F"] h2, main [class*="bg-\\#0A192F"] h3,
-main [class*="bg-\\#0b2f73"] h1, main [class*="bg-\\#0b2f73"] h2, main [class*="bg-\\#0b2f73"] h3 { color: #ffffff !important; }
-/* The public landing page intentionally keeps its light SLT-style cards. */
-main#home .bg-white { background-color: #ffffff !important; background-image: none !important; color: #1e293b !important; border-color: #e2e8f0 !important; }
-main#home .bg-white * { color: inherit; }
-main#home .bg-slate-50, main#home .bg-slate-100 { background-color: #f8fafc !important; background-image: none !important; }
-/* Landing service tiles use the same royal-blue treatment as the app dashboard. */
-main#home #services .bg-white {
-  background: linear-gradient(145deg, #0b2f73, #0d438d 60%, #071d4d) !important;
-  border-color: #3b73c5 !important;
-  color: #ffffff !important;
-}
-main#home #services .bg-white h3,
-main#home #services .bg-white p,
-main#home #services .bg-white span { color: #ffffff !important; }
-main#home #features .bg-\[\#0b2f73\] h3, main#home #features .bg-\[\#0b2f73\] p { color: #ffffff !important; }
-main#home .dashboard-overview, main#home .dashboard-overview h3, main#home .dashboard-overview p, main#home .dashboard-overview span { color: #ffffff !important; }
-
-/* Royal-blue surfaces and high-contrast controls on verification forms. */
+/* Royal-blue surfaces and high-contrast controls for the two remaining
+   pages not yet migrated to the shared component system:
+   VerificationPage.tsx (the all-in-one NIN/BVN catalog) and
+   NinModificationPage.tsx. Scoped to the `.verification-blue-page`
+   wrapper class those two files apply to their own root element - do NOT
+   add this class to pages built with components/verification/shared.tsx
+   (NinPhoneVerificationPage, BvnVerificationPage, ValidationPage,
+   IpeClearancePage, CacServicesPage, PhoneMultiplePage,
+   PersonalizationPage, BvnRetrievalPage), since its bare
+   `input, select, textarea` rule would force their intentionally-white
+   form fields back to dark navy. */
 .verification-blue-page .bg-parchment,
 .verification-blue-page section.bg-parchment,
 .verification-blue-page header.bg-parchment { background: #0b2f73 !important; color: #fff !important; border-color: #3d6fb9 !important; }
