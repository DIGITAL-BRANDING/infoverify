From 943764698dcf08918f49b92cead0551907b751be Mon Sep 17 00:00:00 2001
From: Claude <dev@infoverify.local>
Date: Sun, 30 Aug 2026 10:05:53 +0000
Subject: [PATCH] Add defensive mobile CSS fix for AdminJS list tables
 rendering blank on narrow viewports

---
 .../public/admin-assets/mobile-fix.css        | 56 +++++++++++++++++++
 maria_backend/src/admin/setup.ts              |  7 +++
 maria_backend/src/app.ts                      | 10 ++++
 3 files changed, 73 insertions(+)
 create mode 100644 maria_backend/public/admin-assets/mobile-fix.css

diff --git a/maria_backend/public/admin-assets/mobile-fix.css b/maria_backend/public/admin-assets/mobile-fix.css
new file mode 100644
index 0000000..3939963
--- /dev/null
+++ b/maria_backend/public/admin-assets/mobile-fix.css
@@ -0,0 +1,56 @@
+/*
+ * Defensive mobile fix for AdminJS's built-in List view.
+ *
+ * Reported symptom: on a narrow (phone-width) viewport, list pages like
+ * Service Pricing and Referral Settings show rows with a visible checkbox
+ * and "..." actions menu, but every data column in between renders
+ * completely blank - no service name, price, or any other value text.
+ *
+ * IMPORTANT CONTEXT: this exact deployment has a documented history of
+ * serving a STALE/partial AdminJS bundle after a deploy (see the long
+ * comment above `await admin.initialize()` in admin/setup.ts, added after
+ * a previous "Unexpected token" bug from the same root cause: the admin
+ * router could start serving requests before .adminjs/bundle.js had
+ * finished writing). A stale or partial bundle is the single most likely
+ * explanation for list rows silently losing their column content on some
+ * devices while working on others - if this stylesheet is loading (check
+ * the Network tab for admin-assets/mobile-fix.css) and rows are STILL
+ * blank, restart/redeploy the backend service first (forces a fresh
+ * bundle rebuild) and hard-refresh the browser (clears any cached old
+ * bundle) before assuming this CSS needs to be adjusted further.
+ *
+ * What this stylesheet actually fixes: AdminJS's list table not
+ * reflowing for narrow screens, which can visually squeeze column
+ * content into an effectively zero-width box even though the row itself
+ * still renders at full height. Forcing horizontal scroll (rather than
+ * letting columns collapse) means every column stays at a readable
+ * minimum width and the row becomes scrollable instead of blank.
+ */
+@media (max-width: 900px) {
+  table {
+    display: block !important;
+    width: 100% !important;
+    max-width: 100vw;
+    overflow-x: auto !important;
+    -webkit-overflow-scrolling: touch;
+  }
+  table thead,
+  table tbody,
+  table tr {
+    display: table;
+    width: 100%;
+    table-layout: fixed;
+  }
+  table th,
+  table td {
+    min-width: 110px;
+    white-space: nowrap;
+    overflow: visible !important;
+    text-overflow: unset !important;
+  }
+  /* Belt-and-suspenders: make sure no ancestor is accidentally making list
+     text transparent or zero-size. */
+  table, table * {
+    opacity: 1 !important;
+  }
+}
diff --git a/maria_backend/src/admin/setup.ts b/maria_backend/src/admin/setup.ts
index f397c63..dd789b7 100644
--- a/maria_backend/src/admin/setup.ts
+++ b/maria_backend/src/admin/setup.ts
@@ -101,6 +101,13 @@ export async function buildAdminRouter() {
         }
       }
     },
+    assets: {
+      // See public/admin-assets/mobile-fix.css for what this actually does
+      // and why - fixes AdminJS's built-in list tables rendering blank
+      // (checkbox + "..." menu visible, every data column empty) on
+      // narrow/mobile viewports.
+      styles: ['/admin-assets/mobile-fix.css']
+    },
     resources: [
       userResource,
       transactionResource,
diff --git a/maria_backend/src/app.ts b/maria_backend/src/app.ts
index c24c1f1..5f573f6 100644
--- a/maria_backend/src/app.ts
+++ b/maria_backend/src/app.ts
@@ -129,6 +129,16 @@ export function createApp() {
     express.static(path.join(process.cwd(), 'public', 'branding'), { maxAge: '1d' })
   );
 
+  // Same reasoning as /branding above: extra CSS injected into the AdminJS
+  // panel (see assets.styles in admin/setup.ts) to fix list tables on
+  // mobile. Short maxAge (not '1d' like /branding) since this file is
+  // actively being tuned right now and we don't want a stale cached copy
+  // masking whether a fix actually landed.
+  app.use(
+    '/admin-assets',
+    express.static(path.join(process.cwd(), 'public', 'admin-assets'), { maxAge: '5m' })
+  );
+
   app.use(rateLimit({
     windowMs: 60_000,
     limit: 120,
