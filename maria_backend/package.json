    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/connect-pg-simple": "^7.0.3",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/express-session": "^1.18.0",
        "@types/node": "^22.10.2",
        "@types/pdfkit": "^0.17.6",
        "@types/pg": "^8.11.10",
        "prisma": "^5.22.0",
        "tsx": "^4.19.2",
        "vitest": "^3.2.4",
        "yaml": "^2.9.0"
    },
    "allowScripts": {
        "@firebase/util@1.15.1": true,
        "@prisma/client@5.22.0": true,
        "@prisma/engines@5.22.0": true,
        "esbuild@0.25.12": true,
