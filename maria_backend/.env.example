# Copy this file to .env and fill in real values. Anything left blank falls back
# to the default shown in src/config/env.ts (if one exists) or disables that
# feature gracefully (e.g. leaving WHATSAPP_TOKEN blank just means the WhatsApp
# bot can't reply - it doesn't crash the server).

NODE_ENV=development
PORT=8787
WEB_ALLOWED_ORIGINS=https://your-web-domain.com

# --- Database (Supabase Postgres) -------------------------------------------
# DATABASE_URL goes through the PgBouncer transaction pooler (port 6543) - used
# for normal app queries. DIRECT_URL is the non-pooled connection (port 5432) -
# only used by `prisma migrate`.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Firebase Admin (verifies the Flutter app's Firebase ID tokens) --------
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Alrahuz (upstream VTU provider: data/airtime/result pins) -------------
ALRAHUZ_BASE_URL=https://alrahuzdata.com.ng/api
ALRAHUZ_API_TOKEN=
ALRAHUZ_DATA_PLANS_PATH=/data/
ALRAHUZ_BALANCE_PATH=/user/
ALRAHUZ_EXAM_PIN_PATH=/exam/
ALRAHUZ_WAEC_EXAM_ID=1
ALRAHUZ_NECO_EXAM_ID=2
ALRAHUZ_NABTEB_EXAM_ID=3
ALRAHUZ_FUNDING_ACCOUNT_NUMBER=6651219714
ALRAHUZ_FUNDING_ACCOUNT_NAME=ALRAHUZDATA - IMAM-DATASUB
ALRAHUZ_FUNDING_BANK_NAME=Palmpay Automated Bank Transfer
ALRAHUZ_DATA_PLANS_CACHE_SECONDS=900
ALRAHUZ_LOW_BALANCE_THRESHOLD=2000
ALRAHUZ_LOW_BALANCE_ALERT_COOLDOWN_MINUTES=60

# --- BilalSadaSub (optional upstream VTU provider) -------------------------
BILALSADASUB_BASE_URL=https://bilalsadasub.com
BILALSADASUB_USERNAME=
BILALSADASUB_PASSWORD=
BILALSADASUB_LOW_BALANCE_THRESHOLD=2000
BILALSADASUB_LOW_BALANCE_ALERT_COOLDOWN_MINUTES=60
RESULT_PIN_WAEC_DEFAULT_PRICE_NAIRA=5150
RESULT_PIN_NECO_DEFAULT_PRICE_NAIRA=2150
RESULT_PIN_NABTEB_DEFAULT_PRICE_NAIRA=900
# Percentage deducted from every successful wallet funding (any gateway).
# Set to 0 to disable; change this value and redeploy to change the rate.
WALLET_FUNDING_FEE_PERCENT=2
DATA_PLAN_MARKUP_PERCENT=0
DATA_PLAN_MARKUP_NAIRA=0

# Set to 'false' once ALRAHUZ_API_TOKEN is real and you want live purchases.
MOCK_PROVIDER=false

# --- Techhub (NIN/BVN identity verification - separate from wallet funding) -
TECHHUB_BASE_URL=https://techhubltd.co/api/verification
TECHHUB_API_KEY=
TECHHUB_LOW_BALANCE_THRESHOLD=2000
TECHHUB_LOW_BALANCE_ALERT_COOLDOWN_MINUTES=60
MOCK_TECHHUB=false

# --- Auth / sessions ----------------------------------------------------------
AUTH_TOKEN_SECRET=change-me-to-a-random-32-plus-character-secret
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=2592000
ADMIN_SESSION_SECRET=change-me-to-a-random-secret
PII_ENCRYPTION_KEY=change-me-generate-with-node-crypto-randomBytes-32
SUPABASE_JWT_SECRET=

# =============================================================================
# WALLET FUNDING - two interchangeable gateways
# =============================================================================
# PAYMENT_PROVIDER decides which gateway is actually called for instant virtual
# account provisioning (at signup/login) and dynamic "Pay with Transfer" funding.
# Both providers' credentials can stay filled in below at the same time - if one
# starts giving problems, just flip this to the other value and redeploy. No code
# changes needed. See src/services/payment-provider.service.ts.
#
#   paystack | katpay
PAYMENT_PROVIDER=paystack

# --- Paystack (https://paystack.com/docs) -----------------------------------
PAYSTACK_SECRET_KEY=
# Where Paystack redirects the browser after a card payment (POST /wallet/fund).
PAYSTACK_CALLBACK_URL=https://yourdomain.com/payment/callback
# Bank slug used when issuing a Dedicated Virtual Account. Check GET
# /dedicated_account/available_providers if this ever needs to change.
PAYSTACK_DVA_PREFERRED_BANK=wema-bank
# Whether to create a DVA for every new user immediately at signup, with no BVN.
# Only businesses in Paystack's Financial Services / Betting / General Services
# categories need to set this to 'false' and rely on the BVN-gated flow instead
# (POST /kyc/bvn).
PAYSTACK_INSTANT_DVA_ENABLED=true

# --- KatPay (https://katpay.co/docs) ----------------------------------------
KATPAY_SECRET_KEY=
KATPAY_PUBLIC_KEY=
KATPAY_MERCHANT_ID=
# Where KatPay POSTs the signed payment confirmation for a /wallet/fund/dynamic
# order (POST /v1/transfer-payments's callback_url).
KATPAY_CALLBACK_URL=https://yourdomain.com/payment/callback
# HMAC key used to verify X-Katpay-Signature on inbound webhooks
# (POST /api/webhooks/katpay). KatPay's docs don't show a separate webhook-only
# secret, so this falls back to KATPAY_SECRET_KEY if left blank.
KATPAY_WEBHOOK_SECRET=
# Bank code(s) passed when creating a static virtual account (POST
# /v1/virtual-accounts). See the Bank Codes page in KatPay's docs for the full list.
KATPAY_VIRTUAL_ACCOUNT_BANK_CODE=PALMPAY
# Whether to create a KatPay virtual account for every new user immediately at
# signup - KatPay's virtual-account endpoint has no BVN gate to disable here.
KATPAY_INSTANT_VA_ENABLED=true

# --- WhatsApp Cloud API (buy data by chatting the business number) ---------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
