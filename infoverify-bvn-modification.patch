+import PDFDocument from 'pdfkit';
+import { Prisma, TransactionStatus, TransactionType } from '@prisma/client';
+import { koboToNaira } from '../lib/money.js';
+import { sealPII, openPII } from '../lib/pii.js';
+import { prisma } from '../lib/prisma.js';
+import { ApiError } from '../middleware/error.js';
+import { debitWallet } from './wallet.service.js';
+import { purchaseBvnSlip, purchaseNinByNin } from './verification.service.js';
+import type { TechhubBvnTier, TechhubSlipTier } from './techhub.service.js';
+
+/**
+ * Same manual-review shape as nin-modification.service.ts (see that file's
+ * top comment) - Techhub has no BVN Modification API either, so
+ * submitModificationRequest() below just debits the wallet, renders a PDF of
+ * exactly what the customer submitted, and leaves the transaction PENDING
+ * for an admin to re-key by hand and mark complete or reversed.
+ *
+ * Every type additionally asks for BVN Number, NIN Number, and Enrollment
+ * Type (Agency vs Bank) - the same three fields the reference design repeats
+ * on every one of its eight forms, since a BVN modification is filed against
+ * both numbers and against a specific enrollment channel.
+ */
+export const BVN_MODIFICATION_TYPES = [
+  'update_name',
+  'update_phone',
+  'update_dob',
+  'update_address',
+  'update_name_dob',
+  'update_name_phone',
+  'update_name_address',
+  'update_dob_phone'
+] as const;
+
+export type BvnModificationType = (typeof BVN_MODIFICATION_TYPES)[number];
+
+export type BvnModificationFieldInput = 'text' | 'date' | 'phone' | 'nin' | 'bvn' | 'select';
+
+export type BvnModificationField = {
+  key: string;
+  label: string;
+  required: boolean;
+  input: BvnModificationFieldInput;
+  options?: string[];
+};
+
+type BvnModificationTypeConfig = {
+  id: BvnModificationType;
+  title: string;
+  price: number;
+  fields: BvnModificationField[];
+};
+
+// Bank Verification Number enrollment channels Techhub's own BVN
+// Modification form lists under "Bank" - kept here (not hardcoded per-type)
+// so admin-facing tooling and the frontend can share one source of truth.
+export const BVN_ENROLLMENT_BANKS = [
+  'MICRO FINANCE BANK',
+  'FIRST BANK',
+  'ACCESS BANK',
+  'HERITAGE BANK',
+  'ENTERPRISE BANK',
+  'BOA BANK',
+  'LAPO BANK',
+  'NIBSS'
+] as const;
+
+const enrollmentField: BvnModificationField = { key: 'enrollment_type', label: 'Enrollment Type', required: true, input: 'select', options: ['AGENCY', 'BANK'] };
+// Only meaningful (and only validated as required) when enrollment_type is
+// 'BANK' - see the cross-field check in bvn-modification.routes.ts, which is
+// where that conditional actually gets enforced.
+const bankNameField: BvnModificationField = { key: 'bank_name', label: 'Bank Name', required: false, input: 'select', options: [...BVN_ENROLLMENT_BANKS] };
+const bvnField: BvnModificationField = { key: 'bvn', label: 'BVN Number', required: true, input: 'bvn' };
