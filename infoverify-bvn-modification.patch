+type FieldInput = 'text' | 'date' | 'phone' | 'nin' | 'bvn' | 'select';
+type Field = { key: string; label: string; required: boolean; input: FieldInput; options: string[] | null };
+type TypeConfig = { id: string; title: string; fields: Field[] };
