+RESEND_API_KEY=
+RESEND_FROM_EMAIL=MAJOR DATA-LINK <onboarding@resend.dev>
+# Where lib/alerts.ts sends a notification when something unexpected breaks
+# (an unhandled exception, or a 5xx from an error nobody wrote code to
