+
+# --- Virtual account funding toggle -----------------------------------------
+# Master on/off switch for the KatPay-backed "fund by bank transfer to your
+# own virtual account" flow, independent of KATPAY_INSTANT_VA_ENABLED above
+# (that one controls auto-provisioning at signup; this one controls whether
+# the feature is exposed at all). Defaults to enabled.
+VIRTUAL_ACCOUNT_FUNDING_ENABLED=true
+
+# --- One-time super admin seed (scripts/seed-super-admin.ts) ----------------
+# Only read by `npm run seed:admin` - if any of these three are left blank,
+# that script interactively prompts for them instead. Safe to leave unset in
+# Railway; only useful for a fully non-interactive/scripted initial setup.
+SEED_ADMIN_EMAIL=
+SEED_ADMIN_NAME=
+SEED_ADMIN_PASSWORD=
+
